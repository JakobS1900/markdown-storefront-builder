{
  "name": "markdown-storefront-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Compiles a block document model into host-correct Markdown for people who do not know Markdown.",
  "workspaces": [
    "engine",
    "app"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "lint": "eslint .",
    "secretscan": "node scripts/secret-scan.mjs",
    "a11y": "vitest run app/tests/a11y.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run secretscan && npm run dashscan && npm run a11y && npm run contrast",
    "dashscan": "node scripts/dash-scan.mjs",
    "snapshot": "tsc --build --force && node scripts/write-parity-snapshot.mjs",
    "golden": "tsc --build --force && node scripts/write-golden.mjs",
    "dev": "vite",
    "build:app": "vite build",
    "android:sync": "npm run build:app && cap sync android",
    "android:apk": "npm run android:sync && cd android && .\\gradlew.bat assembleDebug",
    "android:open": "cap open android",
    "contrast": "npm run build:app && node scripts/contrast.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}
