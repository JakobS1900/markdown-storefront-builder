{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "vitest/globals",
      "node"
    ],
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@mdsb/engine": [
        "./engine/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "engine/tests/**/*.ts",
    "app/tests/**/*.ts",
    "scripts/**/*.mjs",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
